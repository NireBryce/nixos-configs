result
.DS_Store
.agents/settings.local.json
# Claude Code writes the user's local allowlist and its subagent
# worktrees under the real .claude/ directory.
/.claude/settings.local.json
/.claude/worktrees/
# python bytecode cache -- any py_compile/import run leaves one behind
__pycache__/
# per-session agent state -- harness output, never repo content. The tracked
# .agents/completed_todos/*.md files are a deliberate convention, which is why
# only the plans/checkpoint dirs are ignored, not .agents/ wholesale.
/.agents/plans/
/.zcode/plans/
/.zcode/completed_todos/
# per-machine ZCode scaffolding, not repo content: .zcode/skills/ held a
# symlink farm into .claude/skills for the #448 parity check, removed with
# #458 -- ZCode scans .agents/skills/ itself, so the farm only duplicated
# every skill in its list. Ignored so a recreated farm can't show as
# untracked noise; .zcode/config.json stays tracked (the mirror test).
/.zcode/skills/
