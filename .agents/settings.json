{
  "attribution": {
    "commit": "Co-Authored-By: Claude"
  },
  "permissions": {
    "allow": [
      "Bash(just wiki-lint)",
      "Bash(just modules)",
      "Bash(just lint)",
      "Bash(just check)",
      "Bash(just preflight)",
      "Bash(just guards-test)",
      "Bash(just agent preflight-brief)",
      "Bash(just agent where)",
      "Bash(just read-sops-names)",
      "Bash(just fingerprint)",
      "Bash(just fingerprint-home)",
      "Bash(just threads *)",
      "Bash(just history-line *)"
    ],
    "deny": [
      "Read(//run/secrets/**)",
      "Read(//run/secrets.d/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/secrets-guard-pretooluse.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/git-guard-pretooluse.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/nix-untracked-guard-pretooluse.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/just-guard-pretooluse.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/lesson-reminder-pretooluse.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/impermanence-edit-guard-pretooluse.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/lesson-reminder-pretooluse.py\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/secrets-read-guard-pretooluse.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/secrets-guard-posttooluse.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/edit-check-posttooluse.sh\""
          }
        ]
      }
    ]
  }
}
