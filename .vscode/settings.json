{
    // nix settings
    "nix.enableLanguageServer": true,
    "[nix]": {
        "editor.tabSize": 4,
        // Nix formatting is off on purpose: nixfmt collapses the aligned `=` columns
        // this repo keeps deliberately (see CLAUDE.md -- `nix fmt` is unwired for the
        // same reason). Carved out per-language so turning editor.formatOnSave on
        // globally for everything else stays safe.
        "editor.formatOnSave": false
        // no "editor.defaultFormatter" -- leaving it unset means Format Document has
        // nothing to invoke for .nix, rather than silently reaching for nixfmt.
    },
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            // An EMPTY command is the off switch. Deleting this block does NOT disable
            // formatting -- nixd's built-in default is `{"nixfmt"}`
            // (Controller/Configuration.h), so an absent block still formats. Empty makes
            // onFormat bail with "formating command is empty" before it ever forks
            // (Controller/Format.cpp). Restore with ["nixfmt"] -- note it must be one
            // argv element per token; ["nixfmt -q"] execvp's a binary of that literal name.
            "formatting": {
                "command": []
            },
            // getFlake takes a flake *directory*, never the flake.nix itself:
            // ".../linux-flake/flake.nix" fails with `path '/nix/store/...-source/flake.nix'
            // does not exist`, because the string is resolved as a flake ref and then
            // flake.nix is looked up *inside* it. The flake lives in linux-flake/, not the
            // repo root, so every path here needs the subdirectory.
            // ${workspaceFolder} does expand -- vscode-nix-ide walks serverSettings
            // recursively through the vscode-variables package (src/utils.ts).
            "nixpkgs": {
                "expr": "import (builtins.getFlake \"${workspaceFolder}/linux-flake\").inputs.nixpkgs {}"
            },
            "options": {
                // <name> in the upstream README is a placeholder, not syntax. One host.
                "nixos": {
                    "expr": "(builtins.getFlake \"${workspaceFolder}/linux-flake\").nixosConfigurations.nire-durandal.options"
                },
                // Home Manager is a NixOS module here (useGlobalPkgs/useUserPackages), so
                // there is no `homeConfigurations` output at all -- reaching for one returns
                // an attribute error and nixd silently serves no HM options. Options have to
                // be dug out of the NixOS config's submodule type instead.
                "home-manager": {
                    "expr": "(builtins.getFlake \"${workspaceFolder}/linux-flake\").nixosConfigurations.nire-durandal.options.home-manager.users.type.getSubOptions []"
                }
                // A `nix-darwin` entry was here, pointing at ${workspaceFolder} -- the repo
                // root, which has no flake.nix -- for darwinConfigurations, which this flake
                // does not have. `elly-user.nix` declares a darwin class for fonts, but
                // nothing consumes it. Removed; restore if darwinConfigurations ever exist.
            }
        }
    },
    "workbench.colorCustomizations": {
        "terminal.background": "#282C34",
        "notebook.outputContainerBackgroundColor": "#a57b5aa5",
        "terminal.foreground": "#ABB2BF",
        "terminalCursor.background": "#ABB2BF",
        "terminalCursor.foreground": "#ABB2BF",
        "terminal.ansiBlack": "#282C34",
        "terminal.ansiBlue": "#61AFEF",
        "terminal.ansiBrightBlack": "#545862",
        "terminal.ansiBrightBlue": "#61AFEF",
        "terminal.ansiBrightCyan": "#56B6C2",
        "terminal.ansiBrightGreen": "#98C379",
        "terminal.ansiBrightMagenta": "#C678DD",
        "terminal.ansiBrightRed": "#E06C75",
        "terminal.ansiBrightWhite": "#C8CCD4",
        "terminal.ansiBrightYellow": "#E5C07B",
        "terminal.ansiCyan": "#56B6C2",
        "terminal.ansiGreen": "#98C379",
        "terminal.ansiMagenta": "#C678DD",
        "terminal.ansiRed": "#E06C75",
        "terminal.ansiWhite": "#ABB2BF",
        "terminal.ansiYellow": "#E5C07B",
        "gitlens.trailingLineForegroundColor": "#000000",
        "gitlens.trailingLineBackgroundColor": "#8a4482",
        "editorBracketHighlight.foreground1": "#5caeef",
        "editorBracketHighlight.foreground2": "#dfb976",
        "editorBracketHighlight.foreground3": "#c172d9",
        "editorBracketHighlight.foreground4": "#4fb1bc",
        "editorBracketHighlight.foreground5": "#97c26c",
        "editorBracketHighlight.foreground6": "#abb2c0",
        "editorBracketHighlight.unexpectedBracket.foreground": "#de7842"
    },
    "editor.rulers": [
