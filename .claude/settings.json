{
  "permissions": {
    "allow": [
      "Bash(HM=/nix/store/2wcgpwi76kxfh27vghs1wnfp5ycfwcqs-source; echo \"=== zoxide bash init ordering ===\"; grep -n -B6 'zoxide init bash' $HM/modules/programs/zoxide.nix | head -14)",
      "Read(//nix/store/2wcgpwi76kxfh27vghs1wnfp5ycfwcqs-source/modules/programs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/secrets-guard-pretooluse.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard-pretooluse.sh\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/secrets-guard-posttooluse.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
