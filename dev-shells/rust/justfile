# Recipes for the rust dev-shell template in this directory.
#
# This flake.nix is a template, not a project of its own -- `create` copies it
# (and rust-toolchain.toml) into a new project directory and lays down a cargo
# project inside the shell it defines, so the new project never needs a rust
# toolchain installed outside nix.
#
# `activate` can't export a toolchain into your CURRENT shell -- a just recipe
# runs in a subprocess, so nothing it sets survives the recipe returning.
# Instead it drops you into `nix develop` interactively: a real shell with
# cargo/rustc/rust-analyzer on PATH that blocks until you exit it.

here := justfile_directory()

_default:
    @just --list

# Scaffold a new rust project at <path>: copies flake.nix in, then `cargo init`s it
create path:
    mkdir -p {{quote(path)}}
    cp {{quote(here)}}/flake.nix {{quote(path)}}/flake.nix
    cp {{quote(here)}}/rust-toolchain.toml {{quote(path)}}/rust-toolchain.toml
    # Inside a git repo a flake only sees tracked files, so the `nix develop`
    # below can't find an un-added flake.nix or rust-toolchain.toml.
    if git -C {{quote(path)}} rev-parse --is-inside-work-tree >/dev/null 2>&1; then git -C {{quote(path)}} add flake.nix rust-toolchain.toml; fi
    # `cargo init` refuses an existing package (dev-new --force over one): keep it.
    if [ -e {{quote(path)}}/Cargo.toml ]; then echo "create: Cargo.toml exists, skipping cargo init"; else cd {{quote(path)}} && nix develop --command cargo init; fi

# Drop into the rust dev shell, blocking until you exit it
activate:
    nix develop {{quote(here)}}
