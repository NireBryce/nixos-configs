#!/usr/bin/env bash
# Runs `just lint`'s ratchet before every commit (or, where nix can't supply
# the lint tools, the offline checks -- see below). Not active by default --
# `git config core.hooksPath .githooks` (or `just install-hooks`) has to point
# git at this directory first; a fresh clone still relies on CI to catch a
# lint regression until that's run once, same as any other opt-in hook.
#
# On PASS-WITH-IMPROVEMENT, lint.py has already rewritten
# flake/scripts/lint-baseline.json in place (see its own header) -- this hook
# re-stages that file so the lowered baseline rides along in the commit that
# earned it, rather than showing up as an unrelated dirty file afterward.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"

# statix/deadnix live only in the dev shell (flake/modules/dev-shell.nix);
# with-nix-tools.sh enters it when they aren't on PATH, and exits 75 when it
# can't -- no nix, or nix can't fetch the flake inputs (a Claude Code cloud
# container has nix and no route to GitHub, so the old "skip if there is no
# nix" test never fired there and the hook failed every commit instead).
# On 75 the ratchet cannot run, so the checks that need neither nix nor
# `just` run in its place (flake/scripts/offline_checks.py): syntax, parse
# and the wiki lint. Any other failure is a real lint regression.
cd "${repo_root}/flake"
if scripts/with-nix-tools.sh . python3 scripts/lint.py check; then
    :
else
    status=$?
    if [ "$status" -ne 75 ]; then
        echo >&2
        echo "pre-commit: lint regression above -- fix it, or 'just lint' to see it" >&2
        echo "  again without committing. --no-verify bypasses this hook if you" >&2
        echo "  really need to; CI still runs the same check on the PR either way." >&2
        exit 1
    fi
    echo "pre-commit: lint ratchet cannot run here (no usable nix); running the offline checks instead." >&2
    python3 "${repo_root}/flake/scripts/offline_checks.py" staged
    # Nothing to re-stage: the ratchet, which rewrites the baseline, did not run.
    exit 0
fi

# `-C "$repo_root"` + a repo-root-relative path, not `cd` + an absolute one.
# Git exports GIT_DIR into a hook's environment so a `git` command the hook
# runs can find "the repository" without re-discovering it -- but in a
# linked worktree that export is GIT_DIR alone, no matching GIT_WORK_TREE,
# and once GIT_DIR is set explicitly `git` stops walking up from cwd to
# find the work-tree root and falls back to cwd itself instead. Run from
# inside flake/ (this hook `cd`s there, above, so lint.py runs the same way
# `just lint` runs it), a plain `git add "$repo_root/flake/scripts/..."`
# inherited that GIT_DIR, silently re-derived flake/ as the top, and staged
# the given *absolute* path relative to that -- dropping the flake/ prefix
# outright and creating a second, stray copy at scripts/lint-baseline.json.
# No error at any layer; caught for real 2026-09-02, landing an unrelated
# docs commit from a worktree (wiki/agent-lessons-learned.md #44 has the full
# repro). `-C "$repo_root"` sidesteps the whole GIT_DIR-vs-cwd question by
# telling git directly what directory to treat as its starting point,
# instead of leaving it to infer one -- githooks(5) itself suggests
# `unset $(git rev-parse --local-env-vars)` for this class of problem, but
# that also clears GIT_INDEX_FILE, which this git process needs to keep
# pointed at the *same* index the outer `git commit` already has open, or
# this `git add` fights it for the index lock instead (see #44's own
# update for how that surfaced).
git -C "${repo_root}" add flake/scripts/lint-baseline.json
