#!/usr/bin/env bash
# Enforces CLAUDE.md's commit-trailer convention: "Co-Authored-By: Claude
# <noreply@anthropic.com>", with no model name. Auto-corrects rather than
# rejecting, because the thing going wrong here isn't a choice an author
# could have caught by re-reading the message -- CLAUDE.md's own "Namespacing"
# / trailer section explains it: the model name is copied from whatever the
# system prompt says, and "an agent cannot verify which model is executing
# it." The log already holds 82 wrong "Sonnet 5" trailers and 54 wrong
# "Opus 5" ones from exactly this, written by an agent with no way to know
# it was wrong. A hook that silently fixes the line prevents #83 without
# asking anyone to remember a rule that isn't independently checkable at
# write time.
#
# Existing commits keep their (wrong) labels per CLAUDE.md -- this only
# touches the message being written right now.
set -euo pipefail
msg_file="$1"

canonical="Co-Authored-By: Claude <noreply@anthropic.com>"
# Matches the trailer whether or not a model name got inserted between
# "Claude" and the email, e.g. "Claude Opus 5 <noreply@anthropic.com>" or
# "Claude Sonnet 5 <noreply@anthropic.com>".
pattern='^Co-Authored-By:[[:space:]]+Claude([[:space:]]+[^<]*)?<noreply@anthropic\.com>[[:space:]]*$'

if grep -qE "$pattern" "$msg_file" && ! grep -qxF "$canonical" "$msg_file"; then
    sed -i -E "s/${pattern}/${canonical}/" "$msg_file"
    echo "commit-msg: corrected the Co-Authored-By trailer to drop the model name" >&2
fi
