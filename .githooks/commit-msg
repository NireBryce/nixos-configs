#!/usr/bin/env bash
# Enforces AGENTS.md's commit-trailer convention: "Co-Authored-By: Claude",
# with no model name and no email. Auto-corrects rather than rejecting,
# because the thing going wrong here isn't a choice an author could have
# caught by re-reading the message -- AGENTS.md's trailer section explains
# it: the model name is copied from whatever the system prompt says, and
# "an agent cannot verify which model is executing it." The log already
# holds 82 wrong "Sonnet 5" trailers and 54 wrong "Opus 5" ones from
# exactly this, written by an agent with no way to know it was wrong. A
# hook that silently fixes the line prevents #83 without asking anyone to
# remember a rule that isn't independently checkable at write time.
#
# This only touches trailers naming Claude -- the convention's exemplar.
# Any other agent's trailer (same shape, its own name, no model, no email)
# passes through untouched; AGENTS.md's rule is that such trailers must be
# formed correctly at write time, because no hook can guess what agent
# wrote a given commit.
#
# Existing commits keep their (wrong) labels per AGENTS.md -- this only
# touches the message being written right now.
#
# Since 2026-09-29 this is the backstop, not the first line: .agents/
# settings.json sets Claude Code's `attribution.commit` to the canonical
# trailer, so the harness no longer tells the model to write a model name
# and email. This hook still covers other harnesses (ZCode, opencode), a
# session started from a stale settings file, and a model that writes the
# old shape anyway. The match takes any capitalization of the trailer key,
# since Claude Code's own default is `Co-authored-by: Claude
# <claude@anthropic.com>` (bracket classes, not a case-insensitive flag:
# BSD sed has none, and this runs on darwin too).
set -euo pipefail
msg_file="$1"

canonical="Co-Authored-By: Claude"
# Matches the trailer whether or not a model name and/or an email got
# appended: "Claude", "Claude Opus 5 <noreply@anthropic.com>",
# "Claude Sonnet 5", "Claude <claude@anthropic.com>", etc. -- all correct
# down to the bare canonical form.
pattern='^[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]+Claude([[:space:]]+[^<]*)?([[:space:]]*<[^>]*>)?[[:space:]]*$'

if grep -qE "$pattern" "$msg_file" && ! grep -qxF "$canonical" "$msg_file"; then
    # Temp file + mv instead of sed -i: BSD sed's "-i -E" eats "-E" as the
    # backup suffix, and this hook runs on both darwin and NixOS.
    tmp=$(mktemp "${msg_file}.XXXXXX")
    sed -E "s/${pattern}/${canonical}/" "$msg_file" > "$tmp"
    mv "$tmp" "$msg_file"
    echo "commit-msg: corrected the Co-Authored-By trailer to the canonical form (agent name only -- no model name, no email)" >&2
fi
