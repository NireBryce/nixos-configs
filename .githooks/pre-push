#!/usr/bin/env bash
# Where the full checks can't run, run the part of `just preflight` that can.
#
# A machine with a working nix gets nothing from this hook: `just preflight`
# is the checklist there and CI repeats it. A machine without -- a Claude Code
# cloud container: nix installed, flake inputs unfetchable, no `just` -- would
# otherwise push having run no tests at all, so here the push runs the
# python steps of preflight (flake/scripts/offline_checks.py preflight, about
# half a minute) and says which steps it had to leave to CI.
#
# Same opt-in as pre-commit: `git config core.hooksPath .githooks`.
# `git push --no-verify` skips it.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"

# 75 = nix cannot provide the lint tools; 0 = it can (the probe is cheap, and
# a success reuses the dev-shell evaluation). Anything else is not ours.
if "${repo_root}/flake/scripts/with-nix-tools.sh" "${repo_root}/flake" true >/dev/null 2>&1; then
    exit 0
else
    status=$?
fi
[ "$status" -eq 75 ] || exit 0

echo "pre-push: no usable nix; running preflight's offline steps." >&2
exec python3 "${repo_root}/flake/scripts/offline_checks.py" preflight
