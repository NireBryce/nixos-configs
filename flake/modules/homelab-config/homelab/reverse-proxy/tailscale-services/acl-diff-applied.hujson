// Tailnet policy -- the repo copy of what is applied (see README.md).
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {"group:golink-admins": ["nirebryce@github"]},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"example-host-1": "100.100.100.100",
		// ts-hive, the backup target for cube's restic. A grant dst
		// cannot name a device, so it gets an alias. Re-check if the NAS is
		// ever re-registered and its 100.x address changes.
		"ts-hive": "100.78.140.91",
	},

	// Access control lists.
	"acls": [],

	// No "ssh" block (Tailscale SSH; no host runs it) and no Funnel
	// `nodeAttrs` -- both were the policy's stock defaults, removed
	// 2026-09-26: the ssh block allowed root, and Funnel let any member
	// device publish a local port to the public internet.

	"tagOwners": {
		"tag:golink-host": ["nirebryce@github"],
		// nixos-configs' homelab (nire-cube): grafana/git-forge move off
		// Caddy path prefixes onto their own Tailscale Services names.
		// See wiki/meta/open-threads.md and wiki/config-structure/categories/reverse-proxy.md.
		"tag:homelab-cube": ["nirebryce@github"],
	},

	// Pre-approves tag:homelab-cube to advertise these services, so
	// advertising them from nire-cube's tailscale config needs no manual
	// click in this console -- the per-service approval step
	// open-threads.md cited as one of the two costs of svc:.
	"autoApprovers": {
		"services": {
			"svc:grafana": ["tag:homelab-cube"],
			"svc:git":     ["tag:homelab-cube"],
		},
	},

	"grants": [
		{
			"src": ["group:golink-admins"],
			"dst": ["tag:golink-host"],
			"app": {"tailscale.com/cap/golink": [{"admin": true}]},
		},
		// Device to device (untagged members, incl. homeassistant, ts-hive
		// and golink's `go` node). Was `ip: ["*"]` until 2026-09-26; now
		// the ports in use. A service reached over the tailnet on a member
		// device needs its port here, or it times out.
		{
			"src": ["autogroup:members"],
			"dst": ["autogroup:members"],
			"ip":  [
				// SSH (and ts-hive SFTP), mosh
				"tcp:22", "udp:60000-61000",
				// HTTP/HTTPS: golink `go`, homeassistant, ts-hive UI
				"tcp:80", "tcp:443",
				// homeassistant UI/app, ts-hive QTS UI
				"tcp:8123", "tcp:8080",
				// KDE Connect
				"tcp:1714-1764", "udp:1714-1764",
				// Moonlight -> Sunshine
				"tcp:47984", "tcp:47989", "tcp:47990", "tcp:48010",
				"udp:47998-48000", "udp:48002", "udp:48010",
				// Steam Remote Play between devices
				"tcp:27036-27037", "udp:27031-27036",
			],
		},
		// Explicit grants for the two services: a virtual service IP is
		// not necessarily covered by the autogroup:members->autogroup:members
		// grant above (that targets real devices) -- verify this is even
		// needed once Services is live; if the blanket grant already
		// covers svc: destinations, these are redundant, not harmful.
		{
			"src": ["autogroup:members"],
			"dst": ["svc:grafana"],
			"ip":  ["*"],
		},
		// Restores general reachability to nire-cube itself: tagging it
		// tag:homelab-cube moved it OUT of autogroup:members as a
		// destination -- the blanket grant above no longer covers it.
		// Found live, 2026-09-07: nire-cube dropped off every other
		// tailnet member's peer list (not just offline -- absent),
		// SSH included, within a minute of the tag taking effect.
		//
		// Narrowed 2026-09-26 from `ip: ["*"]` to the ports actually used.
		// `tailscale0` is a trusted interface on
		// cube (networking.nix), so this grant is the only thing deciding
		// which cube ports a tailnet device reaches. A new tailnet-facing
		// service on cube needs its port added here.
		{
			// SSH (incl. Forgejo git+ssh), Caddy, mosh, KDE Connect,
			// Moonlight -> Sunshine.
			"src": ["autogroup:members"],
			"dst": ["tag:homelab-cube"],
			"ip":  [
				"tcp:22", "tcp:80", "tcp:443", "udp:60000-61000",
				"tcp:1714-1764", "udp:1714-1764",
				"tcp:47984", "tcp:47989", "tcp:47990", "tcp:48010",
				"udp:47998-48000", "udp:48002", "udp:48010",
			],
		},
		// The tagged advertiser needs to reach its own services by name:
		// tagging dropped cube out of autogroup:members as a SOURCE too,
		// so with every svc: grant's src being autogroup:members, no grant
		// matched cube and the control plane sent it no svc: records at
		// all -- netmap ExtraRecords came back null and MagicDNS answered
		// NXDOMAIN for git/grafana on cube only, while
		// every member host resolved fine (hard-IP curl still worked:
		// self-terminated VIP traffic never goes through this grant).
		// A (since removed) server-side service monitor was the first thing
		// on cube to resolve svc: names. Found live 2026-09-14, issue
		// #298; applied and verified same day (cube's netmap ExtraRecords
		// repopulated, MagicDNS NOERROR from cube). Mechanism in this
		// directory's README.
		{
			"src": ["tag:homelab-cube"],
			"dst": ["svc:git", "svc:grafana"],
			"ip":  ["*"],
		},
		// cube's restic backup (sftp:nire@ts-hive) -- cube is tagged, so no
		// autogroup:members grant covers it as a SOURCE (README, the
		// 2026-09-14 section). Missing from 2026-09-07 (the tag) until
		// 2026-09-26: every nightly backup failed "connect to host ts-hive".
		{
			"src": ["tag:homelab-cube"],
			"dst": ["ts-hive"],
			"ip":  ["tcp:22"],
		},
		{
			"src": ["autogroup:members"],
			"dst": ["svc:git"],
			"ip":  ["*"],
		},
	],
}
